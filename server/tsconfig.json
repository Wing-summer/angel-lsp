{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "out",
    "types": ["node"],
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["node_modules", ".vscode-test"]
}
